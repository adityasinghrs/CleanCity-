# Copy this file to .env and fill in your values. NEVER commit .env
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/garbageDB?retryWrites=true&w=majority
# Required, min 16 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@clean.com
# Required to create the first admin (min 8 chars). Use something strong.
ADMIN_PASSWORD=
PORT=5000
CLIENT_URL=http://localhost:3000
